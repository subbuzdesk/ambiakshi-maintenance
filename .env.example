# =====================================================================
# Ambiakshi Maintenance & Housekeeping Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Search Console & Indexing API Configuration
# ---------------------------------------------------------------------
# Path to Google Cloud Service Account JSON file (relative or absolute)
# Required to trigger real Google Indexing API URL_UPDATED notifications.
# If omitted or file not found, the script runs in Live Technical Health Mode
# (inspects HTTP 200 OK vs 40x, canonicals, and meta robots tags).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# Daily URL check/indexing quota (defaults to 200 URLs at 4:00 AM EST)
DAILY_INDEXING_QUOTA=200

# ---------------------------------------------------------------------
# 2. Supabase Keep-Alive Configuration
# ---------------------------------------------------------------------
# Free-tier Supabase projects pause after 7 days of inactivity.
# This maintenance script adds and immediately deletes a dummy row daily.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Table to perform the daily heartbeat on.
# Options:
#   - Leave as '_ambiakshi_heartbeat' (will auto-create table or use upsert)
#   - Or specify an existing table name (e.g. 'profiles', 'audit_logs', 'app_state')
SUPABASE_HEARTBEAT_TABLE=_ambiakshi_heartbeat

# Set to true to delete the dummy row immediately after insertion
SUPABASE_DELETE_DUMMY_ROW_AFTER_INSERT=true

# Optional: Supabase Management API Personal Access Token (PAT)
# Used if you wish to programmatically restore/unpause a suspended project.
SUPABASE_MANAGEMENT_TOKEN=

# ---------------------------------------------------------------------
# 3. Monitored Sitemaps (Comma-separated)
# ---------------------------------------------------------------------
MONITORED_SITEMAPS=https://www.ambiakshi.tools/sitemap.xml,https://mobile.ambiakshi.com/sitemap.xml,https://ambiakshi.com/sitemap.xml,https://slm.ambiakshi.com/sitemap.xml
