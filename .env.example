# =====================================================================
# Ambiakshi Maintenance & Housekeeping Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Google Search Console & Indexing API Configuration
# ---------------------------------------------------------------------
# Path to Google Cloud Service Account JSON file (relative or absolute)
# Required to trigger real Google Indexing API URL_UPDATED notifications.
# If omitted or file not found, the script runs in Live Technical Health Mode
# (inspects HTTP 200 OK vs 40x, canonicals, and meta robots tags).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json

# Daily URL check/indexing quota (defaults to 200 URLs at 4:00 AM EST)
DAILY_INDEXING_QUOTA=200

# ---------------------------------------------------------------------
# 2. Supabase Dual Ecosystem Configuration (Keep-Alive & Audit)
# ---------------------------------------------------------------------
# Free-tier Supabase projects pause after 7 days of inactivity.
# This maintenance suite supports BOTH database instances simultaneously.

# --- Project 1: Ambiakshi Tools Database ---
SUPABASE_TOOLS_URL=https://aglvpztrnfaaxtjdajoh.supabase.co
SUPABASE_TOOLS_SERVICE_ROLE_KEY=your-tools-supabase-service-role-key-here
SUPABASE_TOOLS_ANON_KEY=your-tools-anon-key-here
SUPABASE_TOOLS_HEARTBEAT_TABLE=_ambiakshi_heartbeat

# --- Project 2: Ambiakshi Home Database ---
SUPABASE_HOME_URL=https://your-home-project-id.supabase.co
SUPABASE_HOME_SERVICE_ROLE_KEY=your-home-supabase-service-role-key-here
SUPABASE_HOME_ANON_KEY=sb_publishable_...
SUPABASE_HOME_HEARTBEAT_TABLE=_ambiakshi_heartbeat

# --- Shared Supabase Settings ---
# Set to true to delete the dummy row immediately after insertion
SUPABASE_DELETE_DUMMY_ROW_AFTER_INSERT=true

# Optional: Supabase Management API Personal Access Token (PAT)
# Used if you wish to programmatically restore/unpause a suspended project.
SUPABASE_MANAGEMENT_TOKEN=

# (Legacy / Single Project Fallback)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------------------------
# 3. Monitored Sitemaps (Comma-separated)
# ---------------------------------------------------------------------
MONITORED_SITEMAPS=https://www.ambiakshi.tools/sitemap.xml,https://mobile.ambiakshi.com/sitemap.xml,https://ambiakshi.com/sitemap.xml,https://slm.ambiakshi.com/sitemap.xml

# ---------------------------------------------------------------------
# 4. Discord Weekly Digest & Alert Webhook (Optional)
# ---------------------------------------------------------------------
# Incoming webhook URL for posting the Sunday 3:00 AM executive health card.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# ---------------------------------------------------------------------
# 5. SSL & Domain Expiry Monitoring
# ---------------------------------------------------------------------
# Warn if an SSL certificate expires within this number of days (default: 30)
SSL_EXPIRY_WARNING_DAYS=30

# Domains monitored for SSL expiry (comma-separated)
MONITORED_DOMAINS=www.ambiakshi.tools,ambiakshi.com,mobile.ambiakshi.com,slm.ambiakshi.com

